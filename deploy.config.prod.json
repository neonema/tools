{
  "_comment": "Production deploy targets for GitHub Actions. The OIDC role github-neonema-tools-deploy supplies CI credentials — no awsProfile here.",
  "apps": {
    "platform": {
      "source": "dist",
      "s3Bucket": "neonema-tools-prod",
      "s3Region": "us-east-1",
      "cloudfrontDistributionId": "EGT0I63QAM75Z",
      "s3SyncDelete": false,
      "invalidatePaths": ["/*"],
      "edge": [
        {
          "cloudfrontFunctionName": "revealip-ip-api",
          "functionSource": "apps/revealip/cloudfront/ip-api-function.js"
        },
        {
          "cloudfrontFunctionName": "tools-uri-rewrite",
          "functionSource": "apps/hub/cloudfront/uri-rewrite-function.js"
        }
      ]
    }
  }
}
