{
  "_comment": "Copy to deploy.config.json (gitignored) and fill in real values. The platform entry deploys dist/ to tools.neonema.com using the neonema-tools AWS profile.",
  "apps": {
    "platform": {
      "source": "dist",
      "s3Bucket": "neonema-tools-prod",
      "s3Region": "us-east-1",
      "cloudfrontDistributionId": "EXXXXXXXXXXXX",
      "awsProfile": "neonema-tools",
      "s3SyncDelete": false,
      "invalidatePaths": ["/*"],
      "edge": [
        {
          "cloudfrontFunctionName": "revealip-ip-api",
          "functionSource": "apps/revealip/cloudfront/ip-api-function.js"
        },
        {
          "cloudfrontFunctionName": "tools-uri-rewrite",
          "functionSource": "apps/hub/cloudfront/uri-rewrite-function.js"
        }
      ]
    }
  }
}
