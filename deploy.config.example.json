{
  "_comment": "Target: platform entry deploys dist/ to tools.neonema.com (P1). Per-app entries are interim until cutover.",
  "apps": {
    "platform": {
      "source": "dist",
      "s3Bucket": "neonema-tools-prod",
      "s3Region": "us-east-1",
      "cloudfrontDistributionId": "EXXXXXXXXXXXX",
      "awsProfile": "neonema",
      "s3SyncDelete": false,
      "invalidatePaths": ["/*"],
      "edge": {
        "cloudfrontFunctionName": "revealip-ip-api",
        "functionSource": "apps/revealip/cloudfront/ip-api-function.js"
      }
    },
    "revealip": {
      "source": "apps/revealip/public",
      "s3Bucket": "YOUR_REVEALIP_BUCKET_NAME",
      "s3Region": "us-east-1",
      "cloudfrontDistributionId": "EXXXXXXXXXXXX",
      "awsProfile": "revealip",
      "s3SyncDelete": false,
      "invalidatePaths": ["/*"],
      "edge": {
        "cloudfrontFunctionName": "revealip-ip-api",
        "functionSource": "apps/revealip/cloudfront/ip-api-function.js"
      }
    },
    "json": {
      "source": "apps/json/public",
      "s3Bucket": "YOUR_JSON_BUCKET_NAME",
      "s3Region": "us-east-1",
      "cloudfrontDistributionId": "EYYYYYYYYYYYY",
      "awsProfile": "json",
      "s3SyncDelete": false,
      "invalidatePaths": ["/*"]
    }
  }
}
